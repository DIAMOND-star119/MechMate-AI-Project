# Local Postgres (Phase 2) — user-owned cluster on 5433 (EDB service on 5432 has unknown password)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/mechmate"

# Better Auth (Phase 2)
BETTER_AUTH_SECRET="change-me-in-.env"
BETTER_AUTH_URL="http://localhost:3000"
# Public base URL baked into client JS (production: the Netlify site URL)
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
# Production (Vercel): set BETTER_AUTH_URL to the live origin, e.g.
# "https://mechmate-ai.vercel.app". The server also falls back to VERCEL_URL
# automatically. Extra trusted origins (previews, custom domain), comma-separated:
# BETTER_AUTH_TRUSTED_ORIGINS="https://my-preview.vercel.app"

# Ollama (local fallback)
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

# Groq (cloud default when set; check live ids at /api/ai-status)
GROQ_API_KEY="paste-key-in-.env-never-commit"
GROQ_MODEL="openai/gpt-oss-20b"

# Brave Search (optional web grounding; Wikipedia works without it)
BRAVE_API_KEY=""

# First admin (username, optional)
ADMIN_USERNAME=""
