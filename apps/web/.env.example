# Local Postgres (Phase 2) — user-owned cluster on 5433 (EDB service on 5432 has unknown password)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/mechmate"

# Better Auth (Phase 2)
BETTER_AUTH_SECRET="change-me-in-.env"
BETTER_AUTH_URL="http://localhost:3000"

# Ollama (Phase 5, local default)
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"
